# Supabase — Project Settings > API
# 이 두 값만 클라이언트에 노출해도 된다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 아래는 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (CLAUDE.md §2-5). ---
# 1단계에서는 사용하지 않는다. 필요해지는 단계에서 주석을 푼다.
# SUPABASE_SERVICE_ROLE_KEY=

# --- 한국투자증권 (KIS) OpenAPI — 전부 서버 전용 ---
# apiportal.koreainvestment.com > API 신청(실전투자)에서 발급.
# 잔고조회 등 읽기 전용으로만 사용한다. 주문 API는 호출하지 않는다 (CLAUDE.md §2-1).
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호는 앞 8자리(CANO)와 뒤 2자리 상품코드(ACNT_PRDT_CD)로 나눠서 넣는다.
# 예: 12345678-01 -> KIS_CANO=12345678, KIS_ACNT_PRDT_CD=01
KIS_CANO=
KIS_ACNT_PRDT_CD=
# 실전투자. 모의투자는 https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
# KIS 계좌는 소유자 한 명의 것이다. 이 값을 설정하면 해당 계정만 동기화할 수 있다.
KIS_OWNER_EMAIL=

# Supabase service_role 키 — RLS를 우회한다. 서버 전용, 절대 클라이언트 노출 금지.
# KIS 토큰 캐시(kis_token 테이블) 접근에 필요하다.
SUPABASE_SERVICE_ROLE_KEY=
